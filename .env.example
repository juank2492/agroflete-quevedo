# Copiar a .env.local para desarrollo local. NO subir .env.local al repo.

# --- API ---
API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:4200
LOG_LEVEL=debug

# --- Auth local (JWT propio, NO Cognito) ---
JWT_SECRET=dev-secret-cambia-esto-en-cada-maquina
JWT_EXPIRES_IN=8h
CONF_CODE_TTL_MINUTES=15

# --- DynamoDB Local (emulador offline en Docker) ---
TABLE_NAME=AgrofleteTable
DYNAMO_ENDPOINT=http://localhost:8010
AWS_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Email ---
# Por defecto: Mailpit local (sin auth, sin salida a internet).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="AgrofleteQ <no-reply@agroflete.local>"
# Envío real con un proveedor SMTP (Gmail, SES, Brevo...). Puerto 587 = STARTTLS,
# 465 = TLS implícito (SMTP_SECURE=1). En Gmail, SMTP_PASS es una "app password".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="AgrofleteQ <tu-cuenta@gmail.com>"

# --- Worker ---
OUTBOX_POLL_MS=2000
CRON_DEMO=1
RETRASO_UMBRAL_HORAS=6
