# Copiar a .env.local para desarrollo local. No subir ese archivo al repositorio.

API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:4200
LOG_LEVEL=debug

JWT_SECRET=dev-secret-cambia-esto-en-cada-maquina
JWT_EXPIRES_IN=8h
CONF_CODE_TTL_MINUTES=15

TABLE_NAME=AgrofleteTable
DYNAMO_ENDPOINT=http://localhost:8010
AWS_REGION=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Email: por defecto usa Mailpit local sin autenticación.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="AgrofleteQ <no-reply@agroflete.local>"
# Para un proveedor SMTP: puerto 587 usa STARTTLS; 465 usa TLS implícito.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# SMTP_FROM="AgrofleteQ <tu-cuenta@gmail.com>"

OUTBOX_POLL_MS=2000
CRON_DEMO=1
RETRASO_UMBRAL_HORAS=6

# Exige el pago (simulado) de la solicitud antes de poder asignarla. Ponlo en 0 para demos rápidas.
PAGO_OBLIGATORIO=1

# Destinatario de las alertas operativas (inventario: StockBajo / StockAlto).
ADMIN_EMAIL=admin@agroflete.ec

# Web Push (opcional). Genera un par con:  npx web-push generate-vapid-keys
# Si se dejan vacías, el push queda deshabilitado (el centro de avisos in-app funciona igual).
# Solo tiene efecto en el build de producción del frontend (Service Worker activo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@agroflete.local

# Seguimiento del flete. Servicios públicos gratuitos, sin clave (requieren internet).
# La tarifa se calcula con Haversine y es la que paga el productor (no se recalcula). OSRM solo dibuja la ruta en el mapa.
OSRM_URL=https://router.project-osrm.org
GEOCERCA_ACOPIO_M=300
GEO_CENTRO_LAT=-1.03
GEO_CENTRO_LON=-79.46
GEO_RADIO_KM=90
