{
  "name": "@agroflete/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "infra": "tsx src/infra.ts",
    "wait:dynamo": "tsx --env-file-if-exists=../.env.local src/wait-dynamo.ts",
    "migrate": "tsx --env-file-if-exists=../.env.local src/migrate.ts",
    "migrate:reset": "tsx --env-file-if-exists=../.env.local src/migrate.ts --reset",
    "seed": "tsx --env-file-if-exists=../.env.local src/seed.ts",
    "load": "tsx --env-file-if-exists=../.env.local src/load.ts",
    "coldstart": "tsx --env-file-if-exists=../.env.local src/coldstart.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agroflete/shared": "workspace:*",
    "@aws-sdk/client-dynamodb": "^3.726.0",
    "@aws-sdk/lib-dynamodb": "^3.726.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
